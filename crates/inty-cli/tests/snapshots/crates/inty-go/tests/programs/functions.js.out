/** function makeCounter() => () => Number */
function makeCounter() {
  /** let count: Number */
  let count = 0;
  return () => {
  count++;
  return count;
};
}
/** const next: () => Number */
const next = makeCounter();
next();
next();
console.log(next());
/** const fns: (() => Number)[] */
const fns = [];
/** var i: Number */
for (var i = 0; i < 3; i++) {
  fns.push(() => {
  return i * 10;
});
}
console.log(fns.map((f) => {
  return f();
}).join(","));
/** function sumTo(Number) => Number */
function sumTo(n) {
  function go(i, acc) {
    if (i > n) {
      return acc;
    }
    return go(i + 1, acc + i);
  }
  return go(1, 0);
}
console.log(sumTo(100));
