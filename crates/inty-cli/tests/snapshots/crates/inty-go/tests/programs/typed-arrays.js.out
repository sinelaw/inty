/** function histogram<a> where Indexable a Number Number, a has {length: Number} => (a, Number) => Int32Array */
function histogram(xs, buckets) {
  /** const h: Int32Array */
  const h = new Int32Array(buckets);
  /** var i: Number */
  for (var i = 0; i < xs.length; i++) h[xs[i] % buckets] += 1;
  return h;
}
