/** const xs: Number[] */
const xs = [1];
/** let s: Number */
let s = 0;
/** var i: Number */
for (var i = 0; i < 5; i++) {
  xs[xs.length] = i * 10;
  s += xs[xs.length - 1];
}
console.log(`${xs.length} ${s}`);
