/** let grid: Int32Array */
let grid = new Int32Array(2);
/** function regrow() => Undefined */
function regrow() {
  grid = new Int32Array(grid.length + 1);
}
/** let lens: Number */
let lens = 0;
/** var i: Number */
for (var i = 0; i < 3; i++) {
  regrow();
  grid[0] = i;
  lens += grid.length + grid[0];
}
console.log(lens);
/** const counts: Int32Array */
const counts = new Int32Array(4);
/** function bucket(Number) => Number */
function bucket(v) {
  return v % 4;
}
/** var i: Number */
for (var i = 0; i < 10; i++) {
  counts[bucket(i)] += 1;
}
console.log(`${counts[0]} ${counts[1]} ${counts[2]} ${counts[3]}`);
/** const m: Number[] */
const m = [3, 1, 4, 1, 5, 9, 2, 6];
/** let found: Number */
let found = -1;
outer: /** var i: Number */
for (var i = 0; i < m.length; i++) {
  /** var j: Number */
  for (var j = i + 1; j < m.length; j++) {
    if ((m[i] + m[j]) === 11) {
      found = (i * 10) + j;
      break outer;
    }
    if (m[j] > m[i]) {
      continue outer;
    }
  }
}
console.log(found);
