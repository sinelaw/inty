/** function stats(Number) => Number */
function stats(round) {
  /** const shifted: Number[] */
  const shifted = xs.map((x) => {
  return x + round;
});
  /** const big: Number[] */
  const big = shifted.filter((x) => {
  return x > 5;
});
  return big.reduce((acc, x) => {
  return acc + (x / 10);
}, 0);
}
console.log(stats(1));
console.log(stats(3));
/** const doubled: Number[] */
const doubled = xs.map((x) => {
  return x * 2;
});
/** const firstBig: Number */
