/** const xs: Number[] */
const xs = [3, 1, 4, 1, 5, 9, 2, 6, 5, 3];
/** function square(Number) => Number */
function square(x) {
  return x * x;
}
console.log(xs.map((x) => {
  return x * 2;
}).reduce((a, b) => {
  return a + b;
}, 0));
console.log(xs.filter((x) => {
  return (x % 2) === 1;
}).map((x) => {
  return x + 1;
}).join(","));
console.log(xs.map(square).filter((x) => {
  return x > 10;
}).join(","));
