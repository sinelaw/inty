var request = {url: "", method: "GET", setUrl: function(u) {
  this.url = u;
  return this;
}, setMethod: function(m) {
  this.method = m;
  return this;
}, send: function() {
  return (this.method + " ") + this.url;
}};
/** var response: String */
var response = request.setUrl("/api/users").setMethod("POST").send();
