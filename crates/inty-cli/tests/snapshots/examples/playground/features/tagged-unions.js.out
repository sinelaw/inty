/** function area(s: {kind: "circle", r: Number}
                 | {kind: "square", s: Number}) => Number */
function area(shape) {
  if (shape.kind === "circle") {
    return shape.r;
  } else {
    return shape.s;
  }
}
/** var a: Number */
var a = area({kind: "circle", r: 10});
/** var b: Number */
var b = area({kind: "square", s: 5});
