/** const PI: Number */
const PI = 3.141592653589793;
/** const SOLAR_MASS: Number */
const SOLAR_MASS = (4 * PI) * PI;
/** const DAYS_PER_YEAR: Number */
const DAYS_PER_YEAR = 365.24;
/** function body<a, b, c, d, e, f, g>(a, b, c, d, e, f, g) => {mass: g, vx: d, vy: e, vz: f, x: a, y: b, z: c} */
function body(x, y, z, vx, vy, vz, mass) {
  return {x: x, y: y, z: z, vx: vx, vy: vy, vz: vz, mass: mass};
}
/** function makeBodies() => {mass: Number, vx: Number, vy: Number, vz: Number, x: Number, y: Number, z: Number}[] */
function makeBodies() {
  return [body(0, 0, 0, 0, 0, 0, SOLAR_MASS), body(4.841431442464721, -1.1603200440274284, -0.10362204447112311, 0.001660076642744037 * DAYS_PER_YEAR, 0.007699011184197404 * DAYS_PER_YEAR, (-0.0000690460016972063) * DAYS_PER_YEAR, 0.0009547919384243266 * SOLAR_MASS), body(8.34336671824458, 4.124798564124305, -0.4035234171143214, (-0.002767425107268624) * DAYS_PER_YEAR, 0.004998528012349172 * DAYS_PER_YEAR, 0.000023041729757376393 * DAYS_PER_YEAR, 0.0002858859806661308 * SOLAR_MASS), body(12.894369562139131, -15.111151401698631, -0.22330757889265573, 0.002964601375647616 * DAYS_PER_YEAR, 0.0023784717395948095 * DAYS_PER_YEAR, (-0.000029658956854023756) * DAYS_PER_YEAR, 0.00004366244043351563 * SOLAR_MASS), body(15.379697114850917, -25.919314609987964, 0.17925877295037118, 0.0026806777249038932 * DAYS_PER_YEAR, 0.001628241700382423 * DAYS_PER_YEAR, (-0.00009515922545197159) * DAYS_PER_YEAR, 0.000051513890204661145 * SOLAR_MASS)];
}
/** function offsetMomentum<a, b, c> where Indexable a Number b, Indexable a 0 c, FieldWrite c "vx", FieldWrite c "vy", FieldWrite c "vz", a has {length: Number}, b has {vx: Number, mass: Number, vy: Number, vz: Number}, c has {vx: Number, vy: Number, vz: Number} => (a) => Undefined */
function offsetMomentum(bodies) {
  /** let px: Number */
  let px = 0;
  /** let py: Number */
  let py = 0;
  /** let pz: Number */
  let pz = 0;
  /** var i: Number */
  for (var i = 0; i < bodies.length; i++) {
    const b = bodies[i];
    px += b.vx * b.mass;
    py += b.vy * b.mass;
    pz += b.vz * b.mass;
  }
  const sun = bodies[0];
  sun.vx = (-px) / SOLAR_MASS;
  sun.vy = (-py) / SOLAR_MASS;
  sun.vz = (-pz) / SOLAR_MASS;
}
/** function advance<a, b, c, d> where Indexable a Number b, Indexable a Number c, FieldWrite b "vx", FieldWrite b "vy", FieldWrite b "vz", FieldWrite c "vx", FieldWrite c "vy", FieldWrite c "vz", Indexable a Number d, FieldWrite d "x", FieldWrite d "y", FieldWrite d "z", a has {length: Number}, b has {x: Number, y: Number, z: Number, vx: Number, vy: Number, vz: Number, mass: Number}, c has {x: Number, y: Number, z: Number, mass: Number, vx: Number, vy: Number, vz: Number}, d has {vx: Number, x: Number, vy: Number, y: Number, vz: Number, z: Number} => (a, Number) => Undefined */
function advance(bodies, dt) {
  /** const n: Number */
  const n = bodies.length;
  /** var i: Number */
  for (var i = 0; i < n; i++) {
    const bi = bodies[i];
    /** var j: Number */
    for (var j = i + 1; j < n; j++) {
      const bj = bodies[j];
      /** const dx: Number */
      const dx = bi.x - bj.x;
      /** const dy: Number */
      const dy = bi.y - bj.y;
      /** const dz: Number */
      const dz = bi.z - bj.z;
      /** const d2: Number */
      const d2 = ((dx * dx) + (dy * dy)) + (dz * dz);
      /** const mag: Number */
      const mag = dt / (d2 * Math.sqrt(d2));
      bi.vx -= (dx * bj.mass) * mag;
      bi.vy -= (dy * bj.mass) * mag;
      bi.vz -= (dz * bj.mass) * mag;
      bj.vx += (dx * bi.mass) * mag;
      bj.vy += (dy * bi.mass) * mag;
      bj.vz += (dz * bi.mass) * mag;
    }
  }
  /** var i: Number */
  for (var i = 0; i < n; i++) {
    const b = bodies[i];
    b.x += dt * b.vx;
    b.y += dt * b.vy;
    b.z += dt * b.vz;
  }
}
/** function energy<a, b, c> where Indexable a Number b, Indexable a Number c, a has {length: Number}, b has {mass: Number, vx: Number, vy: Number, vz: Number, x: Number, y: Number, z: Number}, c has {x: Number, y: Number, z: Number, mass: Number} => (a) => Number */
function energy(bodies) {
  /** let e: Number */
  let e = 0;
  /** const n: Number */
  const n = bodies.length;
  /** var i: Number */
  for (var i = 0; i < n; i++) {
    const bi = bodies[i];
    e += (0.5 * bi.mass) * (((bi.vx * bi.vx) + (bi.vy * bi.vy)) + (bi.vz * bi.vz));
    /** var j: Number */
    for (var j = i + 1; j < n; j++) {
      const bj = bodies[j];
      /** const dx: Number */
      const dx = bi.x - bj.x;
      /** const dy: Number */
      const dy = bi.y - bj.y;
      /** const dz: Number */
      const dz = bi.z - bj.z;
      e -= (bi.mass * bj.mass) / Math.sqrt(((dx * dx) + (dy * dy)) + (dz * dz));
    }
  }
  return e;
}
/** function main() => String */
function main() {
  /** const lines: Number[] */
  const lines = [];
  /** const bodies: {mass: Number, vx: Number, vy: Number, vz: Number, x: Number, y: Number, z: Number}[] */
  const bodies = makeBodies();
  offsetMomentum(bodies);
  lines.push(energy(bodies));
  /** var step: Number */
  for (var step = 0; step < 5000000; step++) {
    advance(bodies, 0.01);
  }
  lines.push(energy(bodies));
  return lines.join("\n");
}
/** let report: String */
