/** const W: Number */
const W = 1024;
/** const H: Number */
const H = 1024;
/** let seed: Number */
let seed = 42;
/** function random() => Number */
function random() {
  seed = (seed * 16807) % 2147483647;
  return seed / 2147483647;
}
/** function makeGrid() => Boolean[] */
function makeGrid() {
  /** const g: Boolean[] */
  const g = [];
  /** var i: Number */
  for (var i = 0; i < (W * H); i++) {
    g.push(false);
  }
  return g;
}
/** function step<a, b, c, d, e, f, g, h, i, j> where Indexable a Number b, Testable b, Indexable a Number c, Testable c, Indexable a Number d, Testable d, Indexable a Number e, Testable e, Indexable a Number f, Testable f, Indexable a Number g, Testable g, Indexable a Number h, Testable h, Indexable a Number i, Testable i, Indexable a Number Boolean, Indexable j Number Boolean, IndexWrite j => (a, j) => Undefined */
function step(cur, next) {
  /** var y: Number */
  for (var y = 0; y < H; y++) {
    /** const up: Number */
    const up = (y === 0) ? H - 1 : y - 1;
    /** const down: Number */
    const down = (y === (H - 1)) ? 0 : y + 1;
    /** var x: Number */
    for (var x = 0; x < W; x++) {
      /** const left: Number */
      const left = (x === 0) ? W - 1 : x - 1;
      /** const right: Number */
      const right = (x === (W - 1)) ? 0 : x + 1;
      /** let n: Number */
      let n = 0;
      if (cur[(up * W) + left]) n++;
      if (cur[(up * W) + x]) n++;
      if (cur[(up * W) + right]) n++;
      if (cur[(y * W) + left]) n++;
      if (cur[(y * W) + right]) n++;
      if (cur[(down * W) + left]) n++;
      if (cur[(down * W) + x]) n++;
      if (cur[(down * W) + right]) n++;
      /** const alive: Boolean */
      const alive = cur[(y * W) + x];
      next[(y * W) + x] = (n === 3) || (alive && (n === 2));
    }
  }
}
/** function population<a, b> where Indexable a Number b, Testable b, a has {length: Number} => (a) => Number */
function population(g) {
  /** let count: Number */
  let count = 0;
  /** var i: Number */
  for (var i = 0; i < g.length; i++) {
    if (g[i]) count++;
  }
  return count;
}
/** function main() => String */
function main() {
  seed = 42;
  /** const lines: String[] */
  const lines = [];
  /** let a: Boolean[] */
  let a = makeGrid();
  /** let b: Boolean[] */
  let b = makeGrid();
  /** var i: Number */
  for (var i = 0; i < (W * H); i++) {
    a[i] = random() < 0.3;
  }
  /** var gen: Number */
  for (var gen = 1; gen <= 50; gen++) {
    step(a, b);
    /** const t: Boolean[] */
    const t = a;
    a = b;
    b = t;
    if ((gen % 25) === 0) {
      lines.push(`generation ${gen}: ${population(a)} alive`);
    }
  }
  return lines.join("\n");
}
/** let report: String */
let report = "";
/** var iteration: Number */
for (var iteration = 0; iteration < 4; iteration++) {
  /** const t0: Number */
  const t0 = performance.now();
  report = main();
  console.error(`inty-bench iteration ${iteration} ms ${performance.now() - t0}`);
}
console.log(report);
