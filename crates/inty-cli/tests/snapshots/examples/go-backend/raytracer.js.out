/** function vec<a, b, c>(a, b, c) => {x: a, y: b, z: c} */
function vec(x, y, z) {
  return {x: x, y: y, z: z};
}
/** function add<a, b, c, d, e> where Plus b, Plus d, Plus e, a has {x: b, y: d, z: e}, c has {x: b, y: d, z: e} => (a, c) => {x: b, y: d, z: e} */
function add(a, b) {
  return vec(a.x + b.x, a.y + b.y, a.z + b.z);
}
/** function sub<a, b> where a has {x: Number, y: Number, z: Number}, b has {x: Number, y: Number, z: Number} => (a, b) => {x: Number, y: Number, z: Number} */
function sub(a, b) {
  return vec(a.x - b.x, a.y - b.y, a.z - b.z);
}
/** function scale<a> where a has {x: Number, y: Number, z: Number} => (a, Number) => {x: Number, y: Number, z: Number} */
function scale(a, s) {
  return vec(a.x * s, a.y * s, a.z * s);
}
/** function mul<a, b> where a has {x: Number, y: Number, z: Number}, b has {x: Number, y: Number, z: Number} => (a, b) => {x: Number, y: Number, z: Number} */
function mul(a, b) {
  return vec(a.x * b.x, a.y * b.y, a.z * b.z);
}
/** function dot<a, b> where a has {x: Number, y: Number, z: Number}, b has {x: Number, y: Number, z: Number} => (a, b) => Number */
function dot(a, b) {
  return ((a.x * b.x) + (a.y * b.y)) + (a.z * b.z);
}
/** function norm<a> where a has {x: Number, y: Number, z: Number} => (a) => {x: Number, y: Number, z: Number} */
function norm(a) {
  return scale(a, 1 / Math.sqrt(dot(a, a)));
}
/** function sphere<a, b, c, d, e, f>(a, b, c, d, e, f) => {center: {x: a, y: b, z: c}, color: e, radius: d, reflect: f} */
function sphere(cx, cy, cz, r, color, reflect) {
  return {center: vec(cx, cy, cz), radius: r, color: color, reflect: reflect};
}
/** const spheres: {center: {x: Number, y: Number, z: Number}, color: {x: Number, y: Number, z: Number}, radius: Number, reflect: Number}[] */
const spheres = [sphere(0, 1, 5, 1, vec(0.9, 0.2, 0.2), 0.3), sphere(-2.2, 0.8, 6, 0.8, vec(0.2, 0.9, 0.3), 0.2), sphere(2.2, 1.2, 6.5, 1.2, vec(0.3, 0.4, 0.95), 0.5), sphere(0.8, 0.35, 3.2, 0.35, vec(0.95, 0.85, 0.2), 0.1), sphere(-0.9, 0.3, 3.4, 0.3, vec(0.9, 0.9, 0.9), 0.7)];
/** const light: {x: Number, y: Number, z: Number} */
const light = vec(-4, 7, -2);
/** const INF: Number */
const INF = 1000000000000000000000000000000;
/** let hitIndex: Number */
let hitIndex = -1;
/** function nearestSphere<a, b> where a has {x: Number, y: Number, z: Number}, b has {x: Number, y: Number, z: Number} => (a, b) => Number */
function nearestSphere(orig, dir) {
  /** let best: Number */
  let best = INF;
  hitIndex = -1;
  /** var i: Number */
  for (var i = 0; i < spheres.length; i++) {
    /** const s: {center: {x: Number, y: Number, z: Number}, color: {x: Number, y: Number, z: Number}, radius: Number, reflect: Number} */
    const s = spheres[i];
    /** const oc: {x: Number, y: Number, z: Number} */
    const oc = sub(orig, s.center);
    /** const b: Number */
    const b = dot(oc, dir);
    /** const c: Number */
    const c = dot(oc, oc) - (s.radius * s.radius);
    /** const disc: Number */
    const disc = (b * b) - c;
    if (disc > 0) {
      /** const sq: Number */
      const sq = Math.sqrt(disc);
      /** let t: Number */
      let t = (-b) - sq;
      if (t < 0.0001) {
        t = (-b) + sq;
      }
      if ((t > 0.0001) && (t < best)) {
        best = t;
        hitIndex = i;
      }
    }
  }
  return best;
}
/** function floorHit<a, b> where a has {y: Number}, b has {y: Number} => (b, a) => Number */
function floorHit(orig, dir) {
  if (dir.y >= (-0.000001)) {
    return INF;
  }
  /** const t: Number */
  const t = (-orig.y) / dir.y;
  return (t > 0.0001) ? t : INF;
}
/** function inShadow<a> where a has {x: Number, y: Number, z: Number} => (a) => Boolean */
function inShadow(p) {
  /** const toLight: {x: Number, y: Number, z: Number} */
  const toLight = sub(light, p);
  /** const dist: Number */
  const dist = Math.sqrt(dot(toLight, toLight));
  /** const t: Number */
  const t = nearestSphere(p, scale(toLight, 1 / dist));
  return t < dist;
}
/** function shade<a, b, c, d> where a has {x: Number, y: Number, z: Number}, b has {x: Number, y: Number, z: Number}, c has {x: Number, y: Number, z: Number}, d has {x: Number, y: Number, z: Number} => (a, c, b, d) => {x: Number, y: Number, z: Number} */
function shade(p, n, base, dir) {
  /** const l: {x: Number, y: Number, z: Number} */
  const l = norm(sub(light, p));
  /** const ambient: Number */
  const ambient = 0.08;
  if (inShadow(p)) {
    return scale(base, ambient);
  }
  /** const diffuse: Number */
  const diffuse = Math.max(dot(n, l), 0);
  /** const refl: {x: Number, y: Number, z: Number} */
  const refl = sub(l, scale(n, 2 * dot(n, l)));
  /** const spec: Number */
  const spec = Math.pow(Math.max(dot(refl, dir), 0), 40);
  return add(scale(base, ambient + (diffuse * 0.9)), vec(spec, spec, spec));
}
/** function trace({x: Number, y: Number, z: Number}, {x: Number, y: Number, z: Number}, Number) => {x: Number, y: Number, z: Number} */
function trace(orig, dir, depth) {
  /** const ts: Number */
  const ts = nearestSphere(orig, dir);
  /** const si: Number */
  const si = hitIndex;
  /** const tf: Number */
  const tf = floorHit(orig, dir);
  if ((ts === INF) && (tf === INF)) {
    /** const k: Number */
    const k = 0.5 * (dir.y + 1);
    return add(scale(vec(1, 1, 1), 1 - k), scale(vec(0.5, 0.7, 1), k));
  }
  /** let p: {x: Number, y: Number, z: Number} */
  let p = vec(0, 0, 0);
  /** let n: {x: Number, y: Number, z: Number} */
  let n = vec(0, 1, 0);
  /** let base: {x: Number, y: Number, z: Number} */
  let base = vec(0, 0, 0);
  /** let reflect: Number */
  let reflect = 0;
  if (ts < tf) {
    /** const s: {center: {x: Number, y: Number, z: Number}, color: {x: Number, y: Number, z: Number}, radius: Number, reflect: Number} */
    const s = spheres[si];
    p = add(orig, scale(dir, ts));
    n = norm(sub(p, s.center));
    base = s.color;
    reflect = s.reflect;
  } else {
    p = add(orig, scale(dir, tf));
    /** const check: Boolean */
    const check = ((Math.floor(p.x) + Math.floor(p.z)) % 2) === 0;
    base = check ? vec(0.85, 0.85, 0.85) : vec(0.15, 0.15, 0.15);
    reflect = 0.25;
  }
  /** let color: {x: Number, y: Number, z: Number} */
  let color = shade(p, n, base, dir);
  if ((depth < 4) && (reflect > 0)) {
    /** const r: {x: Number, y: Number, z: Number} */
    const r = sub(dir, scale(n, 2 * dot(dir, n)));
    color = add(scale(color, 1 - reflect), scale(trace(p, r, depth + 1), reflect));
  }
  return color;
}
/** function clamp(Number) => Number */
function clamp(x) {
  return (x < 0) ? 0 : (x > 1) ? 1 : x;
}
/** function main() => String */
function main() {
  /** const lines: String[] */
  const lines = [];
  /** const WIDTH: Number */
  const WIDTH = 1280;
  /** const HEIGHT: Number */
  const HEIGHT = 960;
  /** const eye: {x: Number, y: Number, z: Number} */
  const eye = vec(0, 1.4, -1.5);
  /** let checksum: Number */
  let checksum = 0;
  /** const samples: String[] */
  const samples = [];
  /** var y: Number */
  for (var y = 0; y < HEIGHT; y++) {
    /** var x: Number */
    for (var x = 0; x < WIDTH; x++) {
      /** const dx: Number */
      const dx = (((x + 0.5) / WIDTH) - 0.5) * 1.6;
      /** const dy: Number */
      const dy = (0.5 - ((y + 0.5) / HEIGHT)) * 1.2;
      /** const c: {x: Number, y: Number, z: Number} */
      const c = trace(eye, norm(vec(dx, dy, 1)), 0);
      /** const r: Number */
      const r = Math.floor(clamp(c.x) * 255);
      /** const g: Number */
      const g = Math.floor(clamp(c.y) * 255);
      /** const b: Number */
      const b = Math.floor(clamp(c.z) * 255);
      checksum = ((((checksum * 31) + (r * 65536)) + (g * 256)) + b) % 1000000007;
      if ((x === (WIDTH / 2)) && ((y % 192) === 0)) {
        samples.push(`${r},${g},${b}`);
      }
    }
  }
  lines.push(`checksum ${checksum}`);
  lines.push(samples.join(" "));
  return lines.join("\n");
}
/** let report: String */
let report = "";
/** var iteration: Number */
for (var iteration = 0; iteration < 4; iteration++) {
  /** const t0: Number */
  const t0 = performance.now();
  report = main();
  console.error(`inty-bench iteration ${iteration} ms ${performance.now() - t0}`);
}
console.log(report);
