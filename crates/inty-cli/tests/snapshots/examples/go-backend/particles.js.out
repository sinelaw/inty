/** function vec<a, b>(a, b) => {x: a, y: b} */
function vec(x, y) {
  return {x: x, y: y};
}
/** function add<a, b, c, d> where Plus b, Plus d, a has {x: b, y: d}, c has {x: b, y: d} => (a, c) => {x: b, y: d} */
function add(a, b) {
  return vec(a.x + b.x, a.y + b.y);
}
/** function scale<a> where a has {x: Number, y: Number} => (a, Number) => {x: Number, y: Number} */
function scale(a, s) {
  return vec(a.x * s, a.y * s);
}
/** function simulate(Number, Number) => Number */
function simulate(n, steps) {
  /** const pos: {x: Number, y: Number}[] */
  const pos = [];
  /** const vel: {x: Number, y: Number}[] */
  const vel = [];
  /** var i: Number */
  for (var i = 0; i < n; i++) {
    pos.push(vec(i, -i));
    vel.push(vec(1 + (i / n), 0.5 - (i / n)));
  }
  /** var s: Number */
  for (var s = 0; s < steps; s++) {
    /** var i: Number */
    for (var i = 0; i < n; i++) {
      pos[i] = add(pos[i], scale(vel[i], 0.01));
    }
  }
  /** let sum: Number */
  let sum = 0;
  /** var i: Number */
  for (var i = 0; i < n; i++) {
    sum += pos[i].x + pos[i].y;
  }
  return sum;
}
/** function main() => String */
function main() {
  return String(simulate(1000, 20000));
}
/** let report: String */
let report = "";
/** var iteration: Number */
for (var iteration = 0; iteration < 4; iteration++) {
  /** const t0: Number */
  const t0 = performance.now();
  report = main();
  console.error(`inty-bench iteration ${iteration} ms ${performance.now() - t0}`);
}
console.log(report);
