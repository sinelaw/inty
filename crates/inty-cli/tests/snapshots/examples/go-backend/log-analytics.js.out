/** let seed: Number */
let seed = 2024;
/** function rand() => Number */
function rand() {
  seed = (seed * 16807) % 2147483647;
  return seed / 2147483647;
}
/** const PATHS: String[] */
const PATHS = ["/", "/login", "/api/items", "/api/cart", "/static/app.js", "/static/app.css", "/search", "/checkout"];
/** const STATUS: Number[] */
const STATUS = [200, 200, 200, 200, 200, 304, 301, 404, 500, 200];
/** function parseIntAt(String, Number) => Number */
function parseIntAt(s, i) {
  /** let n: Number */
  let n = 0;
  /** let c: Number */
  let c = s.charCodeAt(i);
  while ((c >= 48) && (c <= 57)) {
    n = (n * 10) + (c - 48);
    i++;
    c = s.charCodeAt(i);
  }
  return n;
}
/** function skipPast(String, Number, Number) => Number */
function skipPast(s, i, ch) {
  while (s.charCodeAt(i) !== ch) {
    i++;
  }
  return i + 1;
}
/** function percentile(Number[], Number, Number) => Number */
function percentile(buckets, total, q) {
  /** let seen: Number */
  let seen = 0;
  /** var i: Number */
  for (var i = 0; i < buckets.length; i++) {
    seen += buckets[i];
    if (seen >= (total * q)) {
      return i;
    }
  }
  return buckets.length - 1;
}
/** function main() => String */
function main() {
  seed = 2024;
  /** const lines: String[] */
  const lines = [];
  /** const parts: String[] */
  const parts = [];
  /** var i: Number */
  for (var i = 0; i < 400000; i++) {
    /** const ip: String */
    const ip = `10.${Math.floor(rand() * 256)}.${Math.floor(rand() * 256)}.${Math.floor(rand() * 256)}`;
    /** const path: String */
    const path = PATHS[Math.floor(rand() * PATHS.length)];
    /** const status: Number */
    const status = STATUS[Math.floor(rand() * STATUS.length)];
    /** const bytes: Number */
    const bytes = Math.floor(rand() * 50000);
    /** const ms: Number */
    const ms = Math.floor((rand() * rand()) * 2000);
    parts.push(`${ip} - - [24/Sep/2026:10:00:00 +0000] "GET ${path} HTTP/1.1" ${status} ${bytes} ${ms}ms
`);
  }
  /** const text: String */
  const text = parts.join("");
  /** const statusCounts: Number[] */
  const statusCounts = [];
  /** const latencyBuckets: Number[] */
  const latencyBuckets = [];
  /** var i: Number */
  for (var i = 0; i < 600; i++) {
    statusCounts.push(0);
  }
  /** var i: Number */
  for (var i = 0; i < 2001; i++) {
    latencyBuckets.push(0);
  }
  /** const pathHits: Number[] */
  const pathHits = [];
  /** const pathBytes: Number[] */
  const pathBytes = [];
  /** var i: Number */
  for (var i = 0; i < PATHS.length; i++) {
    pathHits.push(0);
    pathBytes.push(0);
  }
  /** let lineCount: Number */
  let lineCount = 0;
  /** let totalBytes: Number */
  let totalBytes = 0;
  /** let pos: Number */
  let pos = 0;
  /** const QUOTE: Number */
  const QUOTE = 34;
  /** const SPACE: Number */
  const SPACE = 32;
  /** const NEWLINE: Number */
  const NEWLINE = 10;
  while (pos < text.length) {
    pos = skipPast(text, pos, QUOTE);
    pos = skipPast(text, pos, SPACE);
    /** const pathStart: Number */
    const pathStart = pos;
    pos = skipPast(text, pos, SPACE);
    /** const path: String */
    const path = text.substring(pathStart, pos - 1);
    pos = skipPast(text, pos, QUOTE);
    pos++;
    /** const status: Number */
    const status = parseIntAt(text, pos);
    pos = skipPast(text, pos, SPACE);
    /** const bytes: Number */
    const bytes = parseIntAt(text, pos);
    pos = skipPast(text, pos, SPACE);
    /** const ms: Number */
    const ms = parseIntAt(text, pos);
    pos = skipPast(text, pos, NEWLINE);
    lineCount++;
    totalBytes += bytes;
    statusCounts[status]++;
    latencyBuckets[ms]++;
    /** const p: Number */
    const p = PATHS.indexOf(path);
    pathHits[p]++;
    pathBytes[p] += bytes;
  }
  lines.push(`parsed ${lineCount} lines, ${text.length} bytes of log`);
  lines.push(`bytes served: ${totalBytes}`);
  lines.push(`2xx ${statusCounts[200]}  3xx ${statusCounts[301] + statusCounts[304]}  4xx ${statusCounts[404]}  5xx ${statusCounts[500]}`);
  lines.push(`latency p50 ${percentile(latencyBuckets, lineCount, 0.5)}ms  p90 ${percentile(latencyBuckets, lineCount, 0.9)}ms  p99 ${percentile(latencyBuckets, lineCount, 0.99)}ms`);
  /** var i: Number */
  for (var i = 0; i < PATHS.length; i++) {
    lines.push(`${PATHS[i]}: ${pathHits[i]} hits, ${pathBytes[i]} bytes`);
  }
  return lines.join("\n");
}
/** let report: String */
let report = "";
/** var iteration: Number */
for (var iteration = 0; iteration < 4; iteration++) {
  /** const t0: Number */
  const t0 = performance.now();
  report = main();
  console.error(`inty-bench iteration ${iteration} ms ${performance.now() - t0}`);
}
console.log(report);
