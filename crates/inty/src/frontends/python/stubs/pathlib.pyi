# Built-in `pathlib` module stub for inty. The `/` join operator
# (`Path.__truediv__`) is a user operator protocol inty doesn't model
# (see issue #39); use `.joinpath(...)` instead.
class Path:
    def __init__(self, p: str = ...) -> None: ...
    def exists(self) -> bool: ...
    def is_file(self) -> bool: ...
    def is_dir(self) -> bool: ...
    def read_text(self) -> str: ...
    def write_text(self, data: str) -> None: ...
    def mkdir(self, parents: bool = ..., exist_ok: bool = ...) -> None: ...
    def relative_to(self, other: object) -> Path: ...
    def joinpath(self, other: str) -> Path: ...
    def resolve(self) -> Path: ...
    def unlink(self, missing_ok: bool = ...) -> None: ...
    def iterdir(self) -> list[Path]: ...
    def glob(self, pattern: str) -> list[Path]: ...
    def rglob(self, pattern: str) -> list[Path]: ...
    @classmethod
    def home(cls) -> Path: ...
    @classmethod
    def cwd(cls) -> Path: ...
    name: str
    stem: str
    suffix: str
    parent: Path
