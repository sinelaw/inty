    {
      "id": "py-misses",
      "language": "python",
      "label": "Mistakes mypy lets slip",
      "items": [
        { "id": "py-mixed-plus",          "file": "mixed-plus.py",          "label": "mixed-plus.py",          "blurb": "`+` requires matching operand types",      "expect": "error" },
        { "id": "py-unknown-field",       "file": "unknown-field.py",       "label": "unknown-field.py",       "blurb": "Reading a key the dict doesn't have",      "expect": "error" },
        { "id": "py-bad-annotation",      "file": "bad-annotation.py",      "label": "bad-annotation.py",      "blurb": "Value contradicts its annotation",         "expect": "error" },
        { "id": "py-field-mismatch",      "file": "field-mismatch.py",      "label": "field-mismatch.py",      "blurb": "self.field type fixed by __init__",        "expect": "error" },
        { "id": "py-keyword-typo",        "file": "keyword-typo.py",        "label": "keyword-typo.py",        "blurb": "Misspelt keyword argument name",           "expect": "error" },
        { "id": "py-missing-arg",         "file": "missing-arg.py",         "label": "missing-arg.py",         "blurb": "A required argument left unfilled",        "expect": "error" },
        { "id": "py-distinct-brands",     "file": "distinct-brands.py",     "label": "distinct-brands.py",     "blurb": "Twin classes are still distinct types",    "expect": "error" },
        { "id": "py-union-no-narrow",     "file": "union-no-narrow.py",     "label": "union-no-narrow.py",     "blurb": "Brand-specific method without isinstance", "expect": "error" },
        { "id": "py-literal-out-of-set",  "file": "literal-out-of-set.py",  "label": "literal-out-of-set.py",  "blurb": "Literal alias rejects unknown strings",    "expect": "error" },
        { "id": "py-js-method-on-py",     "file": "js-method-on-py.py",     "label": "js-method-on-py.py",     "blurb": "JS methods don't exist on Python types",   "expect": "error" },
        { "id": "py-return-type",         "file": "return-type-mismatch.py","label": "return-type-mismatch.py","blurb": "`-> int` annotation is enforced",          "expect": "error" },
        { "id": "py-none-return",         "file": "none-return.py",         "label": "none-return.py",         "blurb": "Missing `return` makes the result None",   "expect": "error" }
      ]
