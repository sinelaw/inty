        { "id": "or-fallback",        "label": "or-fallback.js",        "blurb": "Truthy fallback hides type changes", "expect": "ok"    },
        { "id": "mixed-array",        "label": "mixed-array.js",        "blurb": "Mixed arrays look uniform in TS",    "expect": "error" },
        { "id": "missing-prop",       "label": "missing-prop.js",       "blurb": "Reading a property that isn't there", "expect": "error" },
        { "id": "this-leak",          "label": "this-leak.js",          "blurb": "Methods called without their receiver", "expect": "ok"  },
        { "id": "truthy-narrow",      "label": "truthy-narrow.js",      "blurb": "0 and \"\" are falsy — silently",   "expect": "ok"    }
