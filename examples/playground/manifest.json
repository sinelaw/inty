      "label": "TS wouldn't catch this",
      "items": [
        { "id": "string-plus-number", "label": "string-plus-number.js", "blurb": "`+` silently coerces in TS",         "expect": "error" },
        { "id": "or-fallback",        "label": "or-fallback.js",        "blurb": "Truthy fallback hides type changes", "expect": "ok"    },
        { "id": "mixed-array",        "label": "mixed-array.js",        "blurb": "Mixed arrays look uniform in TS",    "expect": "error" },
        { "id": "missing-prop",       "label": "missing-prop.js",       "blurb": "Reading a property that isn't there", "expect": "error" },
        { "id": "this-leak",          "label": "this-leak.js",          "blurb": "Methods called without their receiver", "expect": "ok"  },
        { "id": "truthy-narrow",      "label": "truthy-narrow.js",      "blurb": "0 and \"\" are falsy — silently",   "expect": "ok"    }
      ]
    },
    {
      "id": "py-features",
      "language": "python",
      "label": "Type System",
      "items": [
        { "id": "py-basics",      "file": "basics.py",      "label": "basics.py",      "blurb": "Inference for plain Python",          "expect": "ok" },
        { "id": "py-annotations", "file": "annotations.py", "label": "annotations.py", "blurb": "Type hints enforced as constraints",  "expect": "ok" },
        { "id": "py-control",     "file": "control.py",     "label": "control.py",     "blurb": "if/elif/else and while loops",        "expect": "ok" },
