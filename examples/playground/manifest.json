        { "id": "py-generics",     "file": "generics.py",     "label": "generics.py",     "blurb": "Parametric polymorphism",             "expect": "ok" },
        { "id": "py-classes",      "file": "classes.py",      "label": "classes.py",      "blurb": "Methods, fields, nominal brands",     "expect": "ok" },
        { "id": "py-tagged-unions","file": "tagged-unions.py","label": "tagged-unions.py","blurb": "isinstance narrows a brand union",    "expect": "ok" },
        { "id": "py-higher-order", "file": "higher-order.py", "label": "higher-order.py", "blurb": "First-class functions, compose",      "expect": "ok" },
        { "id": "py-type-aliases", "file": "type-aliases.py", "label": "type-aliases.py", "blurb": "Literal aliases pin a string set",    "expect": "ok" },
        { "id": "py-tuples",       "file": "tuples.py",       "label": "tuples.py",       "blurb": "Tuples + positional destructuring",   "expect": "ok" },
        { "id": "py-list-methods", "file": "list-methods.py", "label": "list-methods.py", "blurb": "append/extend/pop/sort/index",        "expect": "ok" },
        { "id": "py-str-methods",  "file": "str-methods.py",  "label": "str-methods.py",  "blurb": "upper/split/join/replace/startswith", "expect": "ok" },
        { "id": "py-f-strings",    "file": "f-strings.py",    "label": "f-strings.py",    "blurb": "f-strings type-check embedded code",  "expect": "ok" },
        { "id": "py-builtins",     "file": "builtins.py",     "label": "builtins.py",     "blurb": "range, sorted, sum, abs, str, len",   "expect": "ok" }
