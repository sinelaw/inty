        { "id": "structural",      "label": "structural.js",      "blurb": "Row polymorphism — typed by shape", "expect": "ok" },
        { "id": "overloading",     "label": "overloading.js",     "blurb": "Operator type classes",           "expect": "ok" },
        { "id": "unions",          "label": "unions.js",          "blurb": "Control-flow joins",              "expect": "ok" },
        { "id": "method-chaining", "label": "method-chaining.js", "blurb": "Equi-recursive builder types",    "expect": "ok" },
        { "id": "tagged-unions",   "label": "tagged-unions.js",   "blurb": "Discriminated unions + narrowing", "expect": "ok" },
        { "id": "nullable",        "label": "nullable.js",        "blurb": "Optional values, ??, narrowing",  "expect": "ok" },
        { "id": "optional-fields", "label": "optional-fields.js", "blurb": "Row-field presence polymorphism", "expect": "ok" },
        { "id": "classes",         "label": "classes.js",         "blurb": "Class bodies + private fields",   "expect": "ok" },
        { "id": "callable-rows",   "label": "callable-rows.js",   "blurb": "Functions are rows with statics", "expect": "ok" },
        { "id": "higher-order",    "label": "higher-order.js",    "blurb": "First-class functions",           "expect": "ok" },
        { "id": "jsdoc-at-type",   "label": "jsdoc-at-type.js",   "blurb": "JSDoc @type on object fields",    "expect": "ok" }
