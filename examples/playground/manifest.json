      "label": "Type System",
      "items": [
        { "id": "py-basics",       "file": "basics.py",       "label": "basics.py",       "blurb": "Inference for plain Python",          "expect": "ok" },
        { "id": "py-annotations",  "file": "annotations.py",  "label": "annotations.py",  "blurb": "Type hints enforced as constraints",  "expect": "ok" },
